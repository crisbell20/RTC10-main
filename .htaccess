# Set login.php as the directory index
DirectoryIndex login.php

# Session cookie: HttpOnly + SameSite=Lax (Secure is set in PHP when HTTPS is on)
<IfModule mod_php.c>
    php_flag session.cookie_httponly on
    php_value session.cookie_samesite "Lax"
</IfModule>
<IfModule mod_php8.c>
    php_flag session.cookie_httponly on
    php_value session.cookie_samesite "Lax"
</IfModule>

# Enable rewrite engine for future use
RewriteEngine On
RewriteBase /RTC10/

# Block source-control, config, and PHP helpers from HTTP
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^api/config(/|$) - [F,L]
RewriteRule ^api/includes(/|$) - [F,L]

# Database dumps, backups, logs, env files, and markdown must not be downloadable
<FilesMatch "\.(sql|bak|log|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
